# Copy to .env.local for local development. Validated at startup by src/lib/env-schema.ts.
# Server-only values: never prefix secrets with NEXT_PUBLIC_.

# Where Django listens (docker compose publishes it on localhost:8000).
API_ORIGIN=http://localhost:8000

# Must equal the backend's PROXY_SHARED_SECRET (see /.env.example and ADR 0003). ≥ 32 chars.
PROXY_SHARED_SECRET=dev-only-proxy-secret-0123456789abcdef

# development | test | staging | production
APP_ENV=development
