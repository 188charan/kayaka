# Optional overrides for `docker compose` (copy to .env). Every value has a working default.
# Never put real secrets in this file or in .env files committed to git.

# Must match frontend/.env.local PROXY_SHARED_SECRET (ADR 0003).
PROXY_SHARED_SECRET=dev-only-proxy-secret-0123456789abcdef

# Host ports (change if something else already uses them).
POSTGRES_PORT=5432
BACKEND_PORT=8000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# console (readable) or json (as in production)
LOG_FORMAT=console
